    "if not llm_already_trained:\n",
    "    from trl import DPOConfig, DPOTrainer\n",
    "\n",
    "    dpo_lora = LoraConfig(\n",
    "        r=32, lora_alpha=64, lora_dropout=0.05,           # \u2b07 r: 64\u219232 + MLP layers covers more of the model\n",
