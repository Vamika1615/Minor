    "        warmup_steps=200,      # \u2b06 recalculated for 4 epochs (~1750 total steps, 10% warmup)\n",
    "        logging_steps=25,\n",
    "        eval_strategy=\"steps\",\n",
    "        eval_steps=100,   # \u2705 triggers ~2x per epoch at PER_SOURCE=2000; increase if PER_SOURCE < 500\n",
